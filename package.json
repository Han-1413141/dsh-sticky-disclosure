{
  "name": "dsh-sticky-disclosure",
  "version": "1.0.1",
  "description": "DSH Web client plugin: collapse every expanded collapsible section in the conversation (Think / tool cards / command cards...) in one click, with a customizable hotkey.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Han-1413141/dsh-sticky-disclosure.git"
  },
  "homepage": "https://github.com/Han-1413141/dsh-sticky-disclosure#readme",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "client-plugin",
    "ui",
    "sticky",
    "disclosure",
    "collapsible"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": []
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT"
}
